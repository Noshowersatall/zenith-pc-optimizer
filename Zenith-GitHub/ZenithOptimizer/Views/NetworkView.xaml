<UserControl x:Class="Zenith.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,4,32">
            <Grid Margin="0,4,0,24">
                <StackPanel Margin="0,0,260,0">
                    <TextBlock Text="Network" Style="{StaticResource H1}"/>
                    <TextBlock Text="Switch to a faster DNS server. DNS is how your PC looks up websites and game servers — a faster one makes pages and matchmaking start sooner. It doesn't change your in-game ping." Style="{StaticResource Subtitle}"/>
                </StackPanel>
                <Button x:Name="TestButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Test_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Test speed" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,16">
                <DockPanel>
                    <Control x:Name="Spinner" DockPanel.Dock="Right" Style="{StaticResource SpinnerSmall}" Visibility="Collapsed"/>
                    <Border Style="{StaticResource GlyphTile}" Width="46" Height="46">
                        <TextBlock Text="&#xE774;" Style="{StaticResource GlyphText}" FontSize="19"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentTitle" Text="Current DNS" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="CurrentText" Style="{StaticResource ItemDesc}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ItemsControl x:Name="ProviderList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="4,0,16,0" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" Margin="0,0,10,0"/>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentTintBrush}" Margin="0,0,6,0"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="In use" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessTintBrush}"
                                                Visibility="{Binding IsFastest, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Fastest for you" Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDesc}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Addresses}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Latency}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" Margin="0,0,18,0"/>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Use" MinWidth="80" Click="Use_Click"
                                        IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBool}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
