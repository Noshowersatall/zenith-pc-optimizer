<UserControl x:Class="Zenith.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,0,4,0">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,4,0,18">
            <StackPanel Margin="0,0,300,0">
                <TextBlock Text="Processes" Style="{StaticResource H1}"/>
                <TextBlock Text="What's using your CPU and memory right now, updated every 2 seconds. Grouped by app, like Task Manager." Style="{StaticResource Subtitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton x:Name="SortCpu" Style="{StaticResource Pill}" GroupName="ProcSort" Content="Sort by CPU" IsChecked="True" Checked="Sort_Checked"/>
                <RadioButton x:Name="SortMem" Style="{StaticResource Pill}" GroupName="ProcSort" Content="Sort by memory" Checked="Sort_Checked"/>
            </StackPanel>
        </Grid>

        <!-- Summary -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="CpuTotal" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Memory in use" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="MemTotal" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Processes" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="ProcCount" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBox x:Name="Search" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Filter by name…" Margin="0,0,0,12" TextChanged="Search_TextChanged"/>

        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Margin="18,0,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NAME" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="50,0,0,0"/>
            <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Caption}" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource Caption}" FontWeight="SemiBold" TextAlignment="Right"/>
        </Grid>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <ItemsControl x:Name="ProcList" Focusable="False" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Padding="14,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34">
                                    <Border CornerRadius="9" Background="{StaticResource AccentTintBrush}">
                                        <TextBlock Text="{Binding Initial}" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="9" Background="{StaticResource RaisedBrush}"
                                            Visibility="{Binding Source, ElementName=Ico, Converter={StaticResource NullToVis}}">
                                        <Image x:Name="Ico" Width="22" Height="22" Source="{Binding ExePath, Converter={StaticResource ExeIcon}}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" FontSize="13.5" VerticalAlignment="Center" TextAlignment="Right"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="End task" HorizontalAlignment="Right"
                                        Click="Kill_Click" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
