<UserControl x:Class="Zenith.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,4,32">
            <!-- Header -->
            <Grid Margin="0,4,0,24">
                <StackPanel Margin="0,0,300,0">
                    <TextBlock Text="Junk Cleaner" Style="{StaticResource H1}"/>
                    <TextBlock Text="Safely remove temporary files, caches and leftovers. Files that are in use are skipped automatically." Style="{StaticResource Subtitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Style="{StaticResource SecondaryButton}" Content="Rescan" Click="Scan_Click"/>
                    <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Clean_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Clean selected" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Summary -->
            <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Selected for cleanup" FontSize="13" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="TotalText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold"
                                   Foreground="{StaticResource HoloGradient}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TotalSub" Text="Scanning your PC…" Style="{StaticResource ItemDesc}"/>
                    </StackPanel>
                    <Control x:Name="ScanSpinner" Style="{StaticResource Spinner}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <StackPanel x:Name="SelectLinks" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                        <Button Style="{StaticResource SecondaryButton}" Content="Select all" Padding="12,6" Click="SelectAll_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Select none" Padding="12,6" Margin="8,0,0,0" Click="SelectNone_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Items -->
            <ItemsControl x:Name="TargetList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource ModernCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="Item_Click"/>
                                <Border Grid.Column="1" Style="{StaticResource GlyphTile}" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphText}"/>
                                </Border>
                                <StackPanel Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDesc}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
