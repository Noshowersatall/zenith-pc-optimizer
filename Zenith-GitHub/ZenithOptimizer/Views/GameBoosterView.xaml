<UserControl x:Class="Zenith.Views.GameBoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="0,0,4,32">
            <!-- Header -->
            <Grid Margin="0,4,0,24">
                <StackPanel Margin="0,0,330,0">
                    <TextBlock Text="Game Booster" Style="{StaticResource H1}"/>
                    <TextBlock Text="Give your games top CPU priority and your best GPU every time they launch, and clear RAM and background apps out of the way while you play." Style="{StaticResource Subtitle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DetectButton" Style="{StaticResource SecondaryButton}" Click="Detect_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Find my games" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Add_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Add game" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status + settings -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusTitle" Text="Booster is off" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource ItemDesc}" Margin="0,8,0,16"/>
                        <TextBlock Text="When a boosted game starts" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource ItemDesc}" Text="•  Windows launches it with High CPU priority (always, even if Zenith is closed)"/>
                        <TextBlock Style="{StaticResource ItemDesc}" Text="•  It runs on your high-performance GPU, never integrated graphics"/>
                        <TextBlock Style="{StaticResource ItemDesc}" Text="•  Standby RAM is freed, and again during play if memory runs low"/>
                        <TextBlock Style="{StaticResource ItemDesc}" Text="•  OneDrive, Teams, Widgets and similar apps drop to low priority until you quit"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,14">
                            <CheckBox x:Name="AutoBoostSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoBoost_Click"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Live boost" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Watch for your games and boost them as they start." Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <CheckBox x:Name="TraySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Tray_Click"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Keep running in the tray" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Closing the window keeps the booster active." Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <CheckBox x:Name="AutoStartSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoStart_Click"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="13.5"/>
                                <TextBlock Text="Launch quietly in the tray when you sign in." Style="{StaticResource ItemDesc}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ListLabel" Text="YOUR GAMES" Style="{StaticResource SectionLabel}" Margin="4,4,0,10"/>

            <!-- Empty -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Padding="24,22" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource GlyphTile}" Width="46" Height="46">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource GlyphText}" FontSize="20"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="No games yet" Style="{StaticResource H2}"/>
                        <TextBlock Text="Click &quot;Find my games&quot; to detect Epic and Steam games, or add any game's .exe yourself." Style="{StaticResource ItemDesc}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="GameList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="44" Height="44">
                                    <Border CornerRadius="12" Background="{StaticResource AccentGradient}">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="12" Background="{StaticResource RaisedBrush}"
                                            Visibility="{Binding Source, ElementName=Ico, Converter={StaticResource NullToVis}}">
                                        <Image x:Name="Ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding ExePath, Converter={StaticResource ExeIcon}}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" Margin="0,0,10,0"/>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessTintBrush}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Running · boosted" Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ExePath}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Boost" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsBoosted, Mode=TwoWay}" Click="Boost_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from list" Margin="12,0,0,0" Click="Remove_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
