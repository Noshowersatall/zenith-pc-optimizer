<UserControl x:Class="Zenith.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0,0,4,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,4,0,18">
            <TextBlock Text="Disk Space" Style="{StaticResource H1}"/>
            <TextBlock Text="See exactly which folders and files are filling your drives. Click a folder to look inside." Style="{StaticResource Subtitle}"/>
        </StackPanel>

        <!-- Drives -->
        <ItemsControl x:Name="DriveList" DockPanel.Dock="Top" Focusable="False" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" Padding="16,12" Click="Drive_Click" MinWidth="200" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Label}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,10,0,6"/>
                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Scanning -->
        <Border x:Name="ScanCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="22,18" Visibility="Collapsed" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="Cancel_Click"/>
                <Control Style="{StaticResource Spinner}" Width="28" Height="28"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScanTitle" Text="Scanning…" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ScanText" Style="{StaticResource ItemDesc}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Up one level" Click="Back_Click"/>
                <TextBlock x:Name="PathText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                <TextBlock x:Name="PathSize" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12.5"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="TabFolders" Style="{StaticResource Pill}" GroupName="DiskTab" Content="Folders" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabLargest" Style="{StaticResource Pill}" GroupName="DiskTab" Content="100 largest files" Checked="Tab_Checked"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Style="{StaticResource PageScroll}">
            <ItemsControl x:Name="ItemList" Focusable="False" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Row}" Padding="14,10" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonUp="Item_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="236"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource GlyphTile}" Width="34" Height="34" CornerRadius="9">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphText}" FontSize="14"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FullPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Height="8">
                                    <Border CornerRadius="4" Background="{StaticResource TrackBrush}" Width="220" HorizontalAlignment="Left"/>
                                    <Border CornerRadius="4" Background="{StaticResource AccentGradientH}" Width="{Binding BarWidth}" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Show in File Explorer" Margin="10,0,0,0" Click="Reveal_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
