<Window x:Class="Zenith.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zenith Optimizer"
        Width="1200" Height="800" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/zenith.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="14,0,14,16">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,18,0,18">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Zenith" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="PC Optimizer" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Administrator mode" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="MachineText" Text="" Style="{StaticResource Caption}" Margin="16,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,10">
                    <StackPanel x:Name="Nav">
                        <TextBlock Text="OPTIMIZE" Style="{StaticResource NavCaption}" Margin="12,0,0,6"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Game Booster" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE945;" Content="Performance" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE72E;" Content="Privacy" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7E8;" Content="Startup Apps" Checked="Nav_Checked"/>
                        <TextBlock Text="CLEAN UP" Style="{StaticResource NavCaption}"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE74D;" Content="Cleaner" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Debloat" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE738;" Content="Uninstaller" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xEDA2;" Content="Disk Space" Checked="Nav_Checked"/>
                        <TextBlock Text="MONITOR &amp; TOOLS" Style="{StaticResource NavCaption}"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Processes" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xEC4A;" Content="Benchmark" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE774;" Content="Network" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Tools" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1" Background="{StaticResource GlowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Greeting -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,10,0,0">
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource HoloGradientD}">
                    <TextBlock x:Name="AvatarText" Text="?" FontWeight="Bold" FontSize="15" Foreground="#0A0A0C"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HelloText" Text="Hello" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DateText" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <!-- Caption buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
            </StackPanel>

            <!-- Restart banner -->
            <Border x:Name="RestartBanner" Grid.Row="1" Visibility="Collapsed" Margin="40,0,40,8" CornerRadius="12" Padding="16,10"
                    Background="{StaticResource WarningTintBrush}" BorderBrush="#55FFB547" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Later" Padding="14,6" Click="RestartLater_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Restart now" Padding="14,6" Margin="8,0,0,0" Click="RestartNow_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Some changes take full effect after you restart your PC." Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page host -->
            <ContentControl x:Name="PageHost" Grid.Row="2" Margin="40,4,40,0" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ================= Toast ================= -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="244,0,0,28"
                Opacity="0" IsHitTestVisible="False" CornerRadius="12" Padding="18,12" MaxWidth="620"
                Background="#1E1F22" BorderBrush="#2C2D31" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Margin="12,0,0,0" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560"/>
            </StackPanel>
        </Border>

        <!-- ================= Busy overlay ================= -->
        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#E6050506">
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                        <Control x:Name="BusySpinner" Style="{StaticResource Spinner}" Width="48" Height="48" HorizontalAlignment="Left"/>
                        <Border x:Name="BusyCheck" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentGradient}"
                                HorizontalAlignment="Left" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="BusyTitle" Style="{StaticResource H2}" FontSize="20" Margin="0,18,0,0"/>
                    <TextBlock x:Name="BusyStep" Style="{StaticResource Subtitle}" Margin="0,8,0,0" MinHeight="38"/>
                    <ProgressBar x:Name="BusyProgress" Style="{StaticResource SlimProgress}" Margin="0,18,0,0"/>
                    <Button x:Name="BusyDone" Style="{StaticResource PrimaryButton}" Content="Done" HorizontalAlignment="Right"
                            Margin="0,24,0,0" Visibility="Collapsed" Click="BusyDone_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Confirm dialog ================= -->
        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#E6050506">
            <Border Style="{StaticResource Card}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Border Style="{StaticResource GlyphTile}" HorizontalAlignment="Left" Width="44" Height="44">
                        <TextBlock x:Name="ConfirmGlyph" Text="&#xE945;" Style="{StaticResource GlyphText}" FontSize="18"/>
                    </Border>
                    <TextBlock x:Name="ConfirmTitle" Style="{StaticResource H2}" FontSize="20" Margin="0,18,0,0"/>
                    <TextBlock x:Name="ConfirmText" Style="{StaticResource Subtitle}" Margin="0,8,0,0" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Click="ConfirmCancel_Click"/>
                        <Button x:Name="ConfirmOk" Style="{StaticResource PrimaryButton}" Content="Continue" Margin="10,0,0,0" Click="ConfirmOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
